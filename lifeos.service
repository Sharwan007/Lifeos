[Unit]
Description=LifeOS 90 - 90-day discipline system
After=network.target

[Service]
Type=simple
User=lifeos
Group=lifeos
WorkingDirectory=/opt/lifeos
EnvironmentFile=/etc/lifeos.env
ExecStart=__NODE__ /opt/lifeos/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/lifeos

[Install]
WantedBy=multi-user.target
