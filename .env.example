# LifeOS 90 Environment Variables
# Copy to .env or set in your hosting platform (Render, Koyeb, OCI VM, Docker)

# Server
PORT=8080
HOST=0.0.0.0

# HTTP Basic Authentication (strongly recommended on public backends)
APP_USER=admin
APP_PASSWORD=change-me-to-a-long-passphrase

# Frontend CORS (comma-separated list of allowed frontend origins, or *)
# Examples: Vercel, Cloudflare Pages, local development
ALLOWED_ORIGIN=https://YOUR_APP.vercel.app,https://YOUR_PROJECT.pages.dev,http://localhost:3000

# ==============================================================================
# DATABASE CONFIGURATION (Choose ONE: Neon, Supabase, or Local JSON)
# ==============================================================================

# Option 1: Neon Serverless Postgres (Zero dependencies, queries via Neon HTTP)
# Copy the connection string directly from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-your-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or explicitly:
# NEON_DATABASE_URL=postgresql://user:password@ep-your-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Supabase (REST API with service role key)
# Get these from Supabase: Project Settings -> API
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_TABLE=lifeos_state

# Option 3: Local JSON File (default when neither Neon nor Supabase is configured)
DATA_DIR=./data
